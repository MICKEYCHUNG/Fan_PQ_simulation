/*--------------------------------*- C++ -*----------------------------------*\
  0/nut - 見 BC_RULES.md 3.2。不含任何真實幾何/實驗數值，直接沿用即可。
  calculated 型別表示這個場完全由求解器根據其他場（k, omega）算出，
  不需要給初始猜測值以外的東西。
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0;
    }
    fluid3_outlet
    {
        type            calculated;
        value           uniform 0;
    }
    envelope
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
    ringSurface
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
    sealPlate
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
    sealPlate_slave
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
    fanSurface
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
}
