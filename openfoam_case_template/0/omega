/*--------------------------------*- C++ -*----------------------------------*\
  0/omega - 範本（假值），見 BC_RULES.md 3.2

  【這個檔案裡哪些數字是假的】
  mixingLength = 0.07 x 進口管徑（Fluid1，3D，D = 風扇直徑）。
  真實值要用你量測到的 D 代入，這裡假設 D = 1 m：
      mixingLength = 0.07 * (3 * 1) = 0.21

  用「強度 + 長度尺度」而非固定數值，是因為入口速度是算出來的結果
  （壓力驅動法下不是邊界條件直接給定），這兩種邊界條件會隨流量自動調整。
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 10;

boundaryField
{
    inlet
    {
        type            turbulentMixingLengthFrequencyInlet;
        mixingLength    0.21;
        value           uniform 10;
    }
    fluid3_outlet
    {
        type            inletOutlet;
        inletValue      uniform 10;
        value           uniform 10;
    }
    envelope
    {
        type            omegaWallFunction;
        value           uniform 10;
    }
    ringSurface
    {
        type            omegaWallFunction;
        value           uniform 10;
    }
    sealPlate
    {
        type            omegaWallFunction;
        value           uniform 10;
    }
    sealPlate_slave
    {
        type            omegaWallFunction;
        value           uniform 10;
    }
    fanSurface
    {
        type            omegaWallFunction;
        value           uniform 10;
    }
}
