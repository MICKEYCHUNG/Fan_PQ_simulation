/*--------------------------------*- C++ -*----------------------------------*\
  snappyHexMeshDict - 範本（假值）
  單一網格涵蓋 Fluid1+Fluid2+Fluid3+旋轉區，依 MESH_RULES.md 1.0 節
  （不用舊的 Fluid3 O-grid + cyclicAMI 作法，原因見該節：介面兩側流量不守恆）

  【這個檔案裡哪些數字是假的】
  - geometry 內的 refinementRegion（searchableCylinder）座標 point1/point2/radius：
    真實值來自你量測到的風扇轉軸位置（axis_x, axis_z）與轉軸方向（通常是 +Y）。
    這裡用 (0,0) 當轉軸在 X-Z 平面的位置（純屬假設，你的真實轉軸不一定在原點）。
  - locationInMesh：snappyHexMesh 需要一個「確定在流體內部」的點來判斷要保留
    哪一側的網格，不能落在固體（風扇、管壁）內部。真實案例選在遠離風扇的
    直管段中心軸上最安全。
  - addLayersControls 的 firstLayerThickness：真實值 = 0.05mm × s
    （s = D/130mm，見 MESH_RULES.md 第 4 節），這裡先用 0.0001 m 當假值示範數量級。

  【分兩階段執行的原因，見 README「學習重點」】
  本專案在網格數較大時，一次做完 castellate+snap+addLayers 容易把記憶體吃光，
  改成兩次呼叫：第一次只開 castellatedMesh/snap，第二次只開 addLayers。
  下面的 castellatedMesh/snap/addLayers 三個布林值示範「兩次都開」的最終狀態，
  實際跑的時候依記憶體狀況拆成兩次。
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    // 以下四個 STL 來自幾何前處理階段（STEP -> STL，見 TASKS.md 階段 1）
    // envelope = 計算域外殼（含隔板，見 MESH_RULES.md 1.1）
    // fanSurface = 風扇葉片+輪毂
    // ringSurface = wall ring（固定環）
    // sealPlate = 安裝隔板（封住 ring 外側旁通道，見 MESH_RULES.md 1.1）
    envelope.stl
    {
        type triSurfaceMesh;
        name envelope;
        scale 0.001;  // STL 用 mm，OpenFOAM 內部一律用公尺
    }
    fan.stl
    {
        type triSurfaceMesh;
        name fanSurface;
        scale 0.001;
    }
    wallRing.stl
    {
        type triSurfaceMesh;
        name ringSurface;
        scale 0.001;
    }
    sealPlate.stl
    {
        type triSurfaceMesh;
        name sealPlate;
        scale 0.001;
    }

    // 旋轉區（MRF cellZone）加密範圍，同軸圓柱，座標為假值示範
    // 真實值：point1/point2 的 Y 座標見 TASKS.md 2.1（MRF 軸長），
    // radius 見 TASKS.md 2.1（葉尖半徑 + 與 ring 內壁間隙的一半）
    rotatingZoneRegion
    {
        type searchableCylinder;
        point1 (0.0 -0.1 0.0);
        point2 (0.0  0.1 0.0);
        radius 0.3;
    }
}

castellatedMeshControls
{
    maxLocalCells 8000000;
    maxGlobalCells 40000000;
    minRefinementCells 10;
    maxLoadUnbalance 0.10;
    nCellsBetweenLevels 3;

    features
    (
    );

    refinementSurfaces
    {
        envelope      { level (0 0); patchInfo { type wall; } }
        // 葉片表面、ring 表面的加密 level 見 MESH_RULES.md 第 5 節對照表
        fanSurface    { level (3 3); patchInfo { type wall; } }
        ringSurface   { level (2 2); patchInfo { type wall; } }
        sealPlate
        {
            level (0 0);
            faceZone sealPlate;
            faceType baffle;   // 零厚度牆，兩面都是 wall，見 MESH_RULES.md 1.1
            patchInfo { type wall; }
        }
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
        rotatingZoneRegion { mode inside; levels ((1E15 2)); }
    }

    // 假值：真實值要落在流體內部、遠離任何固體表面
    locationInMesh (0.0 5.0 0.0);
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch 3;
    tolerance 2.0;
    nSolveIter 30;
    nRelaxIter 5;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes false;

    layers
    {
        // 只對葉片表面加邊界層，5 層，見 MESH_RULES.md 第 4 節
        fanSurface
        {
            nSurfaceLayers 5;
        }
    }

    expansionRatio 1.2;
    minThickness 0.00005;
    // 假值：真實值 = 0.05mm x s(s = D/130mm)換算成公尺
    firstLayerThickness 0.0001;

    nGrow 0;
    featureAngle 130;
    nRelaxIter 3;
    nSmoothSurfaceNormals 1;
    nSmoothNormals 3;
    nSmoothThickness 10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle 90;
    nBufferCellsNoExtrude 0;
    nLayerIter 50;
}

meshQualityControls
{
    // 數值對應 MESH_RULES.md 第 7 節的網格品質標準
    maxNonOrtho 70;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave 80;
    minVol 1e-13;
    minTetQuality 1e-30;
    minArea -1;
    minTwist 0.02;
    minDeterminant 0.001;
    minFaceWeight 0.02;
    minVolRatio 0.01;
    minTriangleTwist -1;
    nSmoothScale 4;
    errorReduction 0.75;
}

mergeTolerance 1e-6;
