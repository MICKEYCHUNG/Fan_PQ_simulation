/*--------------------------------*- C++ -*----------------------------------*\
  blockMeshDict - 範本(假值),背景網格(整個計算域外殼的 bounding box)

  【這個檔案裡哪些數字是假的】
  8 個頂點座標是計算域外殼(Fluid1+Fluid2+Fluid3,見 MESH_RULES.md 第 1 節)的
  bounding box 六個面,真實值要由你量測到的 D(風扇直徑)與基準面位置算出來:
    半徑方向(X、Z)= ± Fluid2/3 半徑 = ± 2.5 D
    軸向(Y)最小值 = 基準面 Y − 2D(Fluid1 進口端)
    軸向(Y)最大值 = 基準面 Y + 10D(Fluid3 出口端)
  下面用 D = 1 m(假設一個直徑 1 公尺的風扇)算出的假值示範,實際請替換成你自己的 D。

  (163 390 163) 這組網格數對應 MESH_RULES.md 第 5 節的背景邊長規則
  (16mm × s,s = D/130mm):邊長 = 整個軸向長度 / 390 應該要接近 16mm × s。
  本專案後來因為記憶體限制改成 4mm × s(見 README 的「學習重點」),
  網格數因此变多,此範本沿用 4mm × s 的設定。
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

convertToMeters 1;  // 這裡假設頂點座標已經是公尺;真實案例用 mm 幾何時改用 0.001

// D = 1 (假設值)，半徑 = 2.5D = 2.5，軸向從 -2D 到 +10D = -2 到 +10
vertices
(
    (-2.5 -2.0 -2.5)
    ( 2.5 -2.0 -2.5)
    ( 2.5 10.0 -2.5)
    (-2.5 10.0 -2.5)
    (-2.5 -2.0  2.5)
    ( 2.5 -2.0  2.5)
    ( 2.5 10.0  2.5)
    (-2.5 10.0  2.5)
);

blocks
(
    // 格數 = (軸向總長度 / 背景邊長)，背景邊長建議值見 MESH_RULES.md 第 5 節
    hex (0 1 2 3 4 5 6 7) (163 390 163) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    // snappyHexMesh 會用這個背景網格的外殼當起點，之後整個外殼都會被
    // envelope.stl 的真實形狀取代，所以這裡只給一個通用的 patch 名稱
    allBoundary
    {
        type patch;
        faces
        (
            (0 1 2 3)
            (4 5 6 7)
            (0 1 5 4)
            (3 2 6 7)
            (0 3 7 4)
            (1 2 6 5)
        );
    }
);

mergePatchPairs
(
);
