/*--------------------------------*- C++ -*----------------------------------*\
  0/U - 範本（假值），壓力驅動法的初始/邊界條件，見 BC_RULES.md 3.1

  【這個檔案裡哪些數字是假的】
  fanSurface 的 rotatingWallVelocity：origin/axis/omega 必須跟
  constant/MRFProperties 完全一致（同一顆風扇、同一個轉軸、同一個轉速），
  這裡沿用 MRFProperties 範本的假值 origin=(0,0,0)、omega=-104.719755。
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        // 給壓力算流量：速度由壓差決定，不是邊界條件直接給定
        type            pressureInletVelocity;
        value           uniform (0 0 0);
    }
    fluid3_outlet
    {
        // 允許局部回流而不發散
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (0 0 0);
    }
    envelope
    {
        type            noSlip;
    }
    ringSurface
    {
        type            noSlip;
    }
    sealPlate
    {
        type            noSlip;
    }
    sealPlate_slave
    {
        type            noSlip;
    }
    fanSurface
    {
        type            rotatingWallVelocity;
        origin          (0.0 0.0 0.0);
        axis            (0 1 0);
        omega           -104.719755;
        value           uniform (0 0 0);
    }
}
